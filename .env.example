# Clé de signature des sessions : génère-la avec   openssl rand -hex 32
SECRET_KEY=

# false : seul le premier compte peut s'inscrire (il devient admin), ensuite c'est fermé.
# true  : tout le monde peut créer un compte depuis la page d'inscription.
ALLOW_SIGNUP=false

# true derrière Nginx Proxy Manager en HTTPS. Mets false seulement pour un test en http://IP:8085.
COOKIE_SECURE=true

# Clé API Riot (developer.riotgames.com) : active l'import automatique des parties classées en jungle.
# Laisse vide pour garder uniquement la saisie manuelle.
RIOT_API_KEY=

# Intervalle de synchronisation automatique, en minutes (5 minimum).
SYNC_MINUTES=10

# Fuseau horaire utilisé pour dater les parties.
TZ=Europe/Paris
